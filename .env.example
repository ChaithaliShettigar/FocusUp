# Example environment variables for FocusUp project

# backend configuration
MONGODB_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d
OPENROUTER_API_KEY=
FRONTEND_URL=
PORT=5010
NODE_ENV=production

# frontend (Vite) configuration
VITE_API_URL=
VITE_SOCKET_URL=

# Notes:
# FRONTEND_URL can be a single URL or comma-separated URLs.
# Example: FRONTEND_URL=https://focusup.vercel.app,https://focusup-git-main.vercel.app
# VITE_API_URL example: https://your-backend.onrender.com/api
# VITE_SOCKET_URL example: https://your-backend.onrender.com
